{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Provider": "Tamin"
  },
  "Keycloak": {
    "Authority": "",
    "Audience": "accounting-api",
    "RolesClient": "accounting-api",
    "UserIdClaim": "preferred_username",
    "UnitClaim": "vahed_code",
    "RequireHttpsMetadata": true
  },
  "License": {
    "Enforce": false,
    "Path": "license.lic"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Tamin": {
    "Idp": {
      "Audience": ""
    }
  },
  "Idp": {
    "tamin": {
      "External_ClientId": "",
      "External_ClientSecret": "",
      "Server": "",
      "Audience": "",
      "GrantType": "client_credentials",
      "External_Resources": ""
    }
  },
  "CurrentUserServiceConfig": {
    "BaseAddress": "http://account-test.tamin.ir:9091/portal",
    "GetCurrentUserUrl": "/api/v2.0/users"
  },
  "ElamDrmd": {
    "Url": "http://172.16.1.18:4040/Sorat/CentralAccount.asmx"
  },
  "Assistant": {
    "Llm": {
      "Provider": "None",
      "ApiKey": "",
      "Model": "",
      "BaseUrl": "",
      "ProxyUrl": "",
      "TimeoutSeconds": 20,
      "InterpretEnabled": true,
      "TrustAnswers": true,
      "KeepAlive": "30m"
    },
    "Risk": {
      "AnomalyFactor": 2,
      "LookbackMonths": 12,
      "MinSamples": 3
    },
    "Agent": {
      "Enabled": true,
      "MaxToolRounds": 6,
      "HistoryMessages": 12,
      "AllowDataToolsForExternal": false
    },
    "Embedding": {
      "Provider": "None",
      "Model": "bge-m3",
      "BaseUrl": "",
      "TimeoutSeconds": 60,
      "BatchSize": 16,
      "MinSimilarity": 0.5,
      "RelativeMargin": 0.06,
      "SemanticTake": 30,
      "QueryTimeoutSeconds": 8
    }
  }
}
