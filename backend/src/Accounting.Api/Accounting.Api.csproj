<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f5497a90-32c3-4331-bfe5-cbe71187b2f6</UserSecretsId>
    <!-- Feeds Swagger (see IncludeXmlComments in Program.cs) with the XML summaries already
         written on the controllers and their response records. Missing-XML-comment warnings
         (CS1591) are suppressed because coverage is intentionally partial (e.g. interface-impl
         members like GlobalExceptionHandler.TryHandleAsync do not each need their own summary)
         and this project does not otherwise track/enforce full public-API doc coverage. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- خروجی `dotnet publish -o ./publish` داخل پوشهٔ پروژه است؛ بدون این خط، publish بعدی آن را جزو
         پروژه می‌شمارد و هر بار یک publish/publish تودرتو می‌سازد (و build با MSB3030 می‌شکند). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Accounting.Application\Accounting.Application.csproj" />
    <ProjectReference Include="..\Accounting.Infrastructure\Accounting.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Tamin.Framework.Common.Security" Version="1.0.9" />
  </ItemGroup>

</Project>
