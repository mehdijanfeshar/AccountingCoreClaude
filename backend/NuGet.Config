<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="tamin" value="https://nexus.tamin.ir/repository/nuget-v2-group/" />
  </packageSources>
  <config>
    <add key="httpRequestTimeout" value="300000" />
  </config>
</configuration>
